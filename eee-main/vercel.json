{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/ppt/phase2-kickoff", "dest": "/ppt/phase2-kickoff/index.html" },
    { "src": "/ppt/phase2-kickoff/", "dest": "/ppt/phase2-kickoff/index.html" },
    { "src": "/ppt/0609", "dest": "/ppt/0609/index.html" },
    { "src": "/ppt/0609/", "dest": "/ppt/0609/index.html" },
    { "src": "/ppt/finance-ai", "dest": "/ppt/finance-ai/index.html" },
    { "src": "/ppt/finance-ai/", "dest": "/ppt/finance-ai/index.html" },
    { "src": "/proposal", "dest": "/proposal/index.html" },
    { "src": "/proposal/", "dest": "/proposal/index.html" },
    { "src": "/proposal-phase2", "dest": "/proposal-phase2/index.html" },
    { "src": "/proposal-phase2/", "dest": "/proposal-phase2/index.html" },
    { "src": "/phase2-demo1", "dest": "/phase2-demo1/index.html" },
    { "src": "/phase2-demo1/", "dest": "/phase2-demo1/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
